# =============================================================================
# QuantScope - local environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# `.env` is read by docker compose (for interpolation) and by the backend
# (pydantic-settings) and frontend (Next.js) at runtime.
# =============================================================================

# --- PostgreSQL container (docker compose `db` service) -----------------------
POSTGRES_USER=quantscope
POSTGRES_PASSWORD=quantscope
POSTGRES_DB=quantscope
POSTGRES_PORT=5432

# --- Backend (FastAPI) -------------------------------------------------------
# SQLAlchemy URL. Use host `localhost` when running the backend on your machine;
# docker compose overrides this to use host `db` inside the compose network.
QUANTSCOPE_DATABASE_URL=postgresql+psycopg://quantscope:quantscope@localhost:5432/quantscope
QUANTSCOPE_ENVIRONMENT=development
QUANTSCOPE_PRICE_PROVIDER=stooq
QUANTSCOPE_DEFAULT_BENCHMARK_TICKER=SPY
QUANTSCOPE_BACKEND_PORT=8000
# SEC requires a User-Agent identifying you with contact info. Set this before
# running `quantscope seed-securities` against the live SEC service.
QUANTSCOPE_SEC_USER_AGENT=YourName your.email@example.com

# --- Backend tests --------------------------------------------------------------
# Optional: a DISPOSABLE PostgreSQL database. When set, the DB-backed schema and
# seeding tests run; otherwise they are skipped.
# QUANTSCOPE_TEST_DATABASE_URL=postgresql+psycopg://quantscope:quantscope@localhost:5432/quantscope_test

# --- Frontend (Next.js) ----------------------------------------------------
# Base URL the browser uses to reach the API. Must be reachable from the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
